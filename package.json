{
  "name": "astro-pkg-stats",
  "version": "0.1.0",
  "description": "Astro component and helpers that show npm and Packagist (Composer/Laravel) download statistics for your packages.",
  "type": "module",
  "author": "Gabriel Kanev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrGKanev/astro-pkg-stats.git"
  },
  "homepage": "https://github.com/MrGKanev/astro-pkg-stats#readme",
  "bugs": {
    "url": "https://github.com/MrGKanev/astro-pkg-stats/issues"
  },
  "engines": {
    "node": "^18.20.8 || ^20.3.0 || >=22.0.0"
  },
  "keywords": [
    "astro",
    "astro-component",
    "npm",
    "packagist",
    "composer",
    "laravel",
    "downloads",
    "statistics"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./PackageStats.astro": "./src/components/PackageStats.astro"
  },
  "files": [
